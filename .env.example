# ============================================================
# INDIA MARKET AI RESEARCH TERMINAL - ENVIRONMENT CONFIGURATION
# ============================================================

# Environment & Timezone
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/india_market_terminal
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/india_market_terminal
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Application API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Market Data Provider Mesh (Configurable, Free by default)
MARKET_DATA_PRIMARY=free
MARKET_DATA_FALLBACK=free

# Optional Authenticated Upstox Integration (Disabled by default)
# When UPSTOX_ENABLED=false, no Upstox variables are required and terminal operates normally.
UPSTOX_ENABLED=false
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/market/upstox/callback
UPSTOX_ACCESS_TOKEN=

# Pluggable AI Framework (Deterministic RuleProvider active by default; zero paid tokens required)
AI_ACTIVE_PROVIDER=rule_fallback
AI_FALLBACK_PROVIDER=rule_fallback
AI_CACHE_ENABLED=true
AI_CACHE_TTL_DAYS=7

# Pluggable Remote Model Providers (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Telegram Alert Engine (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
